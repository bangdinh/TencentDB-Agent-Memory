# ===================================================
# Custom Environment Configuration Template
# Sao chép file này thành .env trong thư mục custom/
# ===================================================

# Core API Endpoints
MEMORY_CORE_API_URL=http://127.0.0.1:8420
MEMORY_KNOWLEDGE_API_URL=http://127.0.0.1:8424

# Authentication & Keys
MEMORY_API_TOKEN=sk-mem-token-placeholder
MEMORY_TEAM_ID=team-default

# Project Scoped Wiki ID (Riêng cho dự án / custom tools này)
CUSTOM_WIKI_ID=wiki-project-custom

# Custom Services Configuration (Bổ sung khi có feature mới)
# JIRA_BASE_URL=https://your-domain.atlassian.net
# JIRA_API_TOKEN=your_jira_token
# JIRA_USER_EMAIL=your_email@example.com
