# Cấu hình local cho MCP server "tencent-memory".
#
#   cp custom/env/local.env.example custom/env/local.env
#
# custom/env/local.env đã được gitignore — KHÔNG BAO GIỜ commit file đó.

# Endpoint MemoryKnowledge (do deploy/global-images/start-all.sh dựng lên)
KNOWLEDGE_API_URL=http://127.0.0.1:8424

# API token. Lấy từ MemoryCore admin. Đây là secret.
KNOWLEDGE_API_TOKEN=thay-bang-token-cua-ban

# Service id gửi kèm header x-tdai-service-id
KNOWLEDGE_SERVICE_ID=default

# Team dùng để tra/tạo wiki và để ghi. Bắt buộc.
KNOWLEDGE_TEAM_ID=team-xxxxxxxxxx

# Wiki mặc định khi KHÔNG tách theo project (chế độ bộ nhớ dùng chung).
KNOWLEDGE_WIKI_ID=wiki-xxxxxxxx

# ── Tách bộ nhớ theo project (multi-tenant) ──────────────────────────────
# ĐỪNG đặt KNOWLEDGE_PROJECT_ID ở đây — nó là giá trị RIÊNG của từng project,
# khai trong khối "env" của MCP config trong project đó:
#
#   bash custom/new-project.sh <project-id> <thư-mục-project>
#
# Khi có KNOWLEDGE_PROJECT_ID, server bỏ qua KNOWLEDGE_WIKI_ID và dùng wiki
# mang tên đúng bằng project id (tự tạo nếu chưa có).
